# Copy to .env, then run: docker compose up -d --build
# These defaults run the main training app without editing this file.
# Never commit .env. The main branch intentionally retains fake training secrets.

# API -> PostgreSQL (postgres:// URI or native Npgsql key=value both work).
DATABASE_URL=postgres://notes:notes@db:5432/notes

# Next.js server-to-server API destination (also used when building rewrites).
# Rebuild with docker compose up -d --build after changing this value.
API_INTERNAL_URL=http://api:8080

# Published ports bind to loopback only. Change these if a port is already in use.
WEB_PORT=3000
API_PORT=8080
POSTGRES_PORT=5433

# pgAdmin web login (fake training credentials, separate from PostgreSQL).
PGADMIN_PORT=5050
PGADMIN_DEFAULT_EMAIL=admin@team-notes.test
PGADMIN_DEFAULT_PASSWORD=pgadmin-pass-123

# ---- SonarQube lab (docker-compose.sonarqube.yml) --------------------------
# No root to raise vm.max_map_count? disable mmap for the search index:
SONAR_SEARCH_JAVAADDITIONALOPTS=-Dnode.store.allow_mmap=false
# SONARQUBE_IMAGE=sonarqube:community
