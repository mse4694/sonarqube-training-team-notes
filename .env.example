# Copy to .env and fill in real values. Never commit .env (it is in .gitignore).
# Generate a signing secret with:  openssl rand -base64 48

# API -> PostgreSQL (postgres:// URI or native Npgsql key=value both work).
DATABASE_URL=postgres://notes:notes@db:5432/notes

# Session JWT signing key (HS256). Required - the API refuses to start without it.
SESSION_SECRET=

# Session cookies are Secure in production; allow plain http://<lan-ip>:3000 in class.
COOKIE_INSECURE=1

# Attachment storage (optional).
AWS_REGION=ap-southeast-1
S3_BUCKET=team-notes-attachments
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Where the Next.js web app proxies /api/* (server-to-server).
API_INTERNAL_URL=http://api:8080

# ---- SonarQube lab (docker-compose.sonarqube.yml) --------------------------
SONAR_SEARCH_JAVAADDITIONALOPTS=-Dnode.store.allow_mmap=false
# SONARQUBE_IMAGE=sonarqube:community
