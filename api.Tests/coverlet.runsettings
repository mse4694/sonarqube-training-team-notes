<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <!-- SonarQube for .NET reads OpenCover (sonar.cs.opencover.reportsPaths). -->
          <Format>opencover</Format>
          <Exclude>[xunit.*]*,[TeamNotes.Api.Tests]*</Exclude>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
