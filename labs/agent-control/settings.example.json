{
  "permissions": {
    "deny": [
      "Bash",
      "PowerShell",
      "NotebookEdit",
      "Edit(./.claude/**)",
      "Read(./reference/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(Edit|Write|MultiEdit|NotebookEdit)$",
        "hooks": [
          {
            "type": "command",
            "command": "dotnet",
            "timeout": 5,
            "onFailure": "block",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard/AgentGuard.dll"
            ]
          }
        ]
      }
    ]
  }
}
