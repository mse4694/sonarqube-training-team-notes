#!/usr/bin/env bash
# Reuse the tools container, preserving paths within this checkout.
set -euo pipefail
repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)"
lab_cwd="$(pwd -P)"
case "$lab_cwd/" in
  "$repo_root/"*) ;;
  *) echo 'Run scripts/lab-tools from inside the Team Notes checkout.' >&2; exit 2 ;;
esac
if (( $# == 0 )); then
  echo 'Usage: ./scripts/lab-tools <command> [arguments...]' >&2
  exit 2
fi
# Git Bash on Windows (MSYS): Docker Desktop needs the Windows form (C:/...) as
# the bind source, while the container keeps the same /c/... path the shell
# uses. Stop MSYS from rewriting POSIX paths and the mount target on the way
# to docker.exe, which otherwise ends in "too many colons" or a missing workdir.
windows_host=0
case "$(uname -s)" in MINGW*|MSYS*|CYGWIN*) windows_host=1 ;; esac
export LAB_REPO_DIR="$repo_root"
export LAB_REPO_SOURCE="$repo_root"
if (( windows_host )); then
  export MSYS_NO_PATHCONV=1 MSYS2_ARG_CONV_EXCL='*' MSYS2_ENV_CONV_EXCL='LAB_REPO_DIR'
  LAB_REPO_SOURCE="$(cygpath -m "$repo_root")"
fi
# docker.exe reads its own path arguments as Windows paths (/c/... would become C:\c\...).
compose=(docker compose --project-directory "$LAB_REPO_SOURCE" -f "$LAB_REPO_SOURCE/docker-compose.yml")
api_id=$("${compose[@]}" ps --status running -q api)
if [[ -z "$api_id" ]]; then
  echo 'Start the existing Team Notes app with docker compose up -d before running lab tools.' >&2
  exit 1
fi
# A running tools container can retain the old API's network namespace after
# Compose recreates the API. Compare container identities before every exec.
tools_id=$("${compose[@]}" ps --all -q lab-tools)
tools_state=''
tools_compatible=0
inspect_tools() {
  local details line workspace_ok=0 bind_ok=0
  details=$(docker inspect --format '{{println .State.Running .HostConfig.NetworkMode}}{{range .Config.Env}}{{printf "env:%s\n" .}}{{end}}{{range .Mounts}}{{if eq .Type "bind"}}{{printf "bind:%s\t%s\t%t\n" .Source .Destination .RW}}{{end}}{{end}}' "$tools_id") || return 1
  tools_state=${details%%$'\n'*}
  while IFS= read -r line; do
    case "$line" in
      "env:LAB_WORKSPACE=$repo_root") workspace_ok=1 ;;
      "bind:$repo_root"$'\t'"$repo_root"$'\ttrue') bind_ok=1 ;;
      # Docker Desktop reports a Windows bind source in its own form; the target still has to match.
      "bind:"*$'\t'"$repo_root"$'\ttrue') if (( windows_host )); then bind_ok=1; fi ;;
    esac
  done <<< "$details"
  tools_compatible=0
  if (( workspace_ok && bind_ok )); then tools_compatible=1; fi
}
if [[ -n "$tools_id" ]]; then inspect_tools; fi
if [[ "$tools_state" != "true container:$api_id" || "$tools_compatible" != 1 ]]; then
  # Build and startup chatter must not contaminate redirected JSON/report stdout.
  if ! docker image inspect team-notes-lab-tools:latest >/dev/null 2>&1; then
    "${compose[@]}" build --quiet lab-tools >&2
  fi
  recreate=()
  if [[ -n "$tools_id" && ( "$tools_state" != "false container:$api_id" || "$tools_compatible" != 1 ) ]]; then
    recreate=(--force-recreate)
  fi
  "${compose[@]}" up -d --no-deps --no-build --pull never "${recreate[@]}" lab-tools >&2
  tools_id=$("${compose[@]}" ps --all -q lab-tools)
  if [[ -z "$tools_id" ]]; then
    echo 'The lab-tools container did not start.' >&2
    exit 1
  fi
  inspect_tools
  current_api=$("${compose[@]}" ps --status running -q api)
  if [[ "$current_api" != "$api_id" || "$tools_state" != "true container:$api_id" || "$tools_compatible" != 1 ]]; then
    echo 'The tools workspace or API network does not match; rerun the command after the app is ready.' >&2
    exit 1
  fi
fi
# exec does not run an image's ENTRYPOINT. Invoke it explicitly for each command
# so HOME, UID/GID and no-new-privileges match the mounted checkout owner.
exec "${compose[@]}" exec -T --workdir "$lab_cwd" lab-tools /usr/local/bin/lab-tools-entrypoint "$@"
