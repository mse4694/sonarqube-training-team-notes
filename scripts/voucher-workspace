#!/usr/bin/env bash
# Prepare the single voucher workspace that Workshops 8-10 share, once.
# Writes .lab-workspaces/voucher.env; later runs keep the existing workspace.
set -euo pipefail
repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)"
workspaces="$repo_root/.lab-workspaces"
env_file="$workspaces/voucher.env"
stop() { echo "Stop: $*; do not replace your work with a fresh fixture." >&2; exit 1; }

if [[ -f "$env_file" ]]; then
  # shellcheck source=/dev/null
  source "$env_file"
  [[ -d "${WORKFLOW_DIR:-}" ]] || stop "$env_file points to a missing WORKFLOW_DIR (${WORKFLOW_DIR:-unset})"
  if [[ ! -f "$WORKFLOW_DIR/Voucher/VoucherService.cs" ]]; then
    # The voucher labs moved from Python to C#; an older Python copy cannot run the current steps.
    stop "$WORKFLOW_DIR is an older Python voucher workspace; move it and $env_file aside, then run this again"
  fi
  echo "Keeping existing workspace: $WORKFLOW_DIR"
  exit 0
fi

# A workspace without its env file still holds learner work: never start over silently.
shopt -s nullglob
orphans=("$workspaces"/voucher.*/)
if (( ${#orphans[@]} )); then
  stop "found workspace(s) without $env_file: ${orphans[*]}; restore voucher.env or move them aside first"
fi

legacy_env="$HOME/.voucher-workflow.env"
legacy_dir=''
if [[ -f "$legacy_env" ]]; then
  # Carry over a workspace created by an older version of this lab.
  legacy_dir=$(
    set +u
    # shellcheck source=/dev/null
    source "$legacy_env"
    printf '%s' "${WORKFLOW_DIR:-}"
  )
  [[ -d "$legacy_dir" ]] || stop "$legacy_env points to a missing WORKFLOW_DIR (${legacy_dir:-unset})"
  [[ -f "$legacy_dir/Voucher/VoucherService.cs" ]] || stop "$legacy_env points to an older Python voucher workspace; move $legacy_env aside to start the C# fixture"
fi

mkdir -p "$workspaces"
new_dir=$(mktemp -d "$workspaces/voucher.XXXXXX")
# Remove only the half-made new copy if anything fails or is interrupted.
trap 'rm -rf -- "$new_dir"; stop "could not prepare the workspace"' ERR
trap 'rm -rf -- "$new_dir"; exit 130' INT TERM

if [[ -n "$legacy_dir" ]]; then
  cp -a "$legacy_dir/." "$new_dir/"
  echo "Copied existing workspace from $legacy_dir"
else
  # Copy the source only: build output (bin/obj) from another checkout path must not come along.
  tar -C "$repo_root/labs/workflow-security" --exclude=bin --exclude=obj -cf - . | tar -C "$new_dir" -xf -
  # The checker's comparison engines and provided contract are answers, so main does not carry them: fetch them from
  # the solution-day2 branch into this private (git-ignored) workspace and check them against main's hash list.
  solution_repo=${VOUCHER_SOLUTION_REPO:-https://github.com/mikelopster/sonarqube-training-team-notes.git}
  fetch_engines() {
    git -C "$repo_root" fetch --quiet --no-tags "$solution_repo" solution-day2 || return 1
    git -C "$repo_root" archive FETCH_HEAD labs/workflow-security/reference/Engines labs/workflow-security/reference/ContractTests.cs \
      | tar -C "$new_dir" --strip-components=2 -xf - || return 1
    (cd "$new_dir" && sha256sum --quiet -c reference/ENGINES.sha256) || return 1
  }
  if ! fetch_engines; then
    rm -rf -- "$new_dir"
    trap - ERR INT TERM
    stop "could not fetch or verify the comparison engines from branch solution-day2 of $solution_repo (needs network once)"
  fi
  echo "Fetched the checker's comparison engines from branch solution-day2 (hashes OK)"
fi

printf 'export TRAINING_ROOT=%q\nexport LAB_PACK_DIR=%q\nexport LAB_TOOLS=%q\nexport WORKFLOW_DIR=%q\n' \
  "$repo_root" "$repo_root/labs" "$repo_root/scripts/lab-tools" "$new_dir" > "$env_file.tmp"
mv "$env_file.tmp" "$env_file"
trap - ERR INT TERM
echo "Created workspace: $new_dir"
